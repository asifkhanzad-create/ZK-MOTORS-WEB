# Copy to .env.local and fill in. `.env.local` is gitignored (see .gitignore);
# this file is committed on purpose so the shape of the config is documented.
#
# Both values come from the Supabase dashboard: Project Settings -> API.
# Do not put a real key in this file.

# Safe to expose — it ships to the browser and is protected by row-level
# security. That is why it carries the NEXT_PUBLIC_ prefix.
#
# Supabase renamed this key: the dashboard issues it as `sb_publishable_...`
# where it used to be a JWT labelled "anon". Same thing, new format. The
# variable keeps the conventional name because `@supabase/supabase-js` takes it
# as the `anonKey` option.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key

# NOT prefixed NEXT_PUBLIC_, on purpose. This key bypasses row-level security
# completely, so it must never reach a client component. It is only for server
# actions and route handlers. Leave it unset until a write path actually needs
# it — reads do not.
SUPABASE_SERVICE_ROLE_KEY=
